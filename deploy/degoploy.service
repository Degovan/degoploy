[Unit]
Description=degoploy webhook deploy runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=degoploy
Group=degoploy
ExecStart=/usr/local/bin/degoploy serve --config /etc/degoploy/degoploy.yaml
# Secrets such as DEGOPLOY_OIDC_SECRET. degoploy never passes DEGOPLOY_* to deploy scripts.
EnvironmentFile=-/etc/degoploy/degoploy.env
WorkingDirectory=/var/lib/degoploy
StateDirectory=degoploy
StateDirectoryMode=0700
# /run/degoploy/admin.sock: the CLI talks to the service through it. Members of
# the degoploy group may use it, so they manage degoploy without sudo.
RuntimeDirectory=degoploy
RuntimeDirectoryMode=0750
# Deployments leave files the web server's group may write to (with the setgid
# projects folder that setup makes). The data directory itself stays 0700.
UMask=0002

Restart=on-failure
RestartSec=5s
# On stop, running deployments get 60s to finish before degoploy cancels them.
# KillMode=mixed sends SIGTERM to degoploy only, so it can shut down cleanly;
# whatever is left in the cgroup is killed when the timeout expires.
KillMode=mixed
TimeoutStopSec=90s
LimitNOFILE=65536

# Hardening that leaves deploy scripts working.
PrivateTmp=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectClock=true
RestrictRealtime=true
LockPersonality=true

# Stricter options. Enable only if your deploy scripts allow it:
# NoNewPrivileges=true    breaks deployments: they start as deploy_user through sudo
# ProtectSystem=full      makes /usr and /etc read-only for scripts
# ProtectHome=true        hides /home (projects deployed there would fail)

[Install]
WantedBy=multi-user.target
